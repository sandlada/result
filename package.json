{
    "name": "@sandlada/result",
    "version": "0.0.5-20260725.a",
    "description": "Type-safe Result Pattern & ROP for TypeScript — Explicit Error Handling without Exceptions",
    "type": "module",
    "main": "./build/index.js",
    "types": "./build/index.d.ts",
    "exports": {
        ".": {
            "types": "./build/index.d.ts",
            "default": "./build/index.js"
        },
        "./option": {
            "types": "./build/option/index.d.ts",
            "default": "./build/option/index.js"
        },
        "./types": {
            "types": "./build/types/index.d.ts",
            "default": "./build/types/index.js"
        },
        "./factories": {
            "types": "./build/factories/index.d.ts",
            "default": "./build/factories/index.js"
        },
        "./operators": {
            "types": "./build/operators/index.d.ts",
            "default": "./build/operators/index.js"
        },
        "./promise-result": {
            "types": "./build/promise-result/index.d.ts",
            "default": "./build/promise-result/index.js"
        },
        "./composition": {
            "types": "./build/composition/index.d.ts",
            "default": "./build/composition/index.js"
        },
        "./adapters": {
            "types": "./build/adapters/index.d.ts",
            "default": "./build/adapters/index.js"
        },
        "./combine": {
            "types": "./build/combine/index.d.ts",
            "default": "./build/combine/index.js"
        },
        "./async-result": {
            "types": "./build/async-result/index.d.ts",
            "default": "./build/async-result/index.js"
        },
        "./async-option": {
            "types": "./build/async-option/index.d.ts",
            "default": "./build/async-option/index.js"
        },
        "./promise-option": {
            "types": "./build/promise-option/index.d.ts",
            "default": "./build/promise-option/index.js"
        },
        "./reliability": {
            "types": "./build/reliability/index.d.ts",
            "default": "./build/reliability/index.js"
        },
        "./observability": {
            "types": "./build/observability/index.d.ts",
            "default": "./build/observability/index.js"
        },
        "./primitives": {
            "types": "./build/primitives/index.d.ts",
            "default": "./build/primitives/index.js"
        }
    },
    "files": [
        "build/",
        "README.md",
        "LICENSE",
        "CODE_OF_CONDUCT.md",
        "SECURITY.md"
    ],
    "scripts": {
        "build": "npm run build:types && npm run build:js",
        "build:types": "tsc --project tsconfig.build.json",
        "build:js": "rolldown --config",
        "typecheck": "tsc --project tsconfig.json --noEmit",
        "test": "vitest run",
        "test:watch": "vitest",
        "bench": "vitest bench",
        "bench:json": "vitest bench --outputJson=results.json",
        "bench:ui": "vitest bench --ui"
    },
    "repository": {
        "type": "git",
        "url": "git+https://github.com/sandlada/result.git"
    },
    "bugs": {
        "url": "https://github.com/sandlada/result/issues"
    },
    "homepage": "https://github.com/sandlada/result",
    "keywords": [
        "result",
        "result-pattern",
        "rop",
        "railway-oriented",
        "option",
        "async-result",
        "promise-result",
        "either",
        "error-handling",
        "retry",
        "timeout",
        "observability",
        "functional",
        "typescript"
    ],
    "publishConfig": {
        "access": "public"
    },
    "author": "Kai-Orion & Sandlada",
    "license": "MIT",
    "devDependencies": {
        "@vitest/coverage-v8": "^4.1.10",
        "@vitest/ui": "^4.1.10",
        "rolldown": "^1.2.0",
        "typescript": "^7.0.2",
        "vitest": "^4.1.10"
    }
}
