{
    "name": "@sandlada/result-docs",
    "private": true,
    "type": "module",
    "description": "Documentation site for @sandlada/result, built with Astro Starlight.",
    "scripts": {
        "sync": "node scripts/sync-narrative.mjs",
        "predev": "npm run sync",
        "dev": "astro dev",
